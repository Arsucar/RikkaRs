<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
  <cloud-backup>
    <include
      domain="file"
      path="upload/" />
    <include
      domain="external"
      path="workspaces/" />
  </cloud-backup>
  <device-transfer>
    <include
      domain="file"
      path="upload/" />
    <include
      domain="external"
      path="workspaces/" />
  </device-transfer>
</data-extraction-rules>
